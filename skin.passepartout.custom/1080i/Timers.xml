<?xml version="1.0" encoding="UTF-8"?>
<!-- Skin timers (Kodi 20+). -->
<timers>
	<!-- custom: install / update the skin's keymaps (scripts/install_keymap.py) once per session, after 90 s idle -->
	<timer>
		<name>nocturne_keymap</name>
		<description>Install the skin's keymaps into userdata</description>
		<start reset="false">System.IdleTime(90) + String.IsEmpty(Window(Home).Property(pp.keymapcheck))</start>
		<onstart>SetProperty(pp.keymapcheck,1,home)</onstart>
		<onstart>RunScript(special://skin/scripts/install_keymap.py)</onstart>
		<stop>!String.IsEmpty(Window(Home).Property(pp.keymapcheck))</stop>
	</timer>
	<!-- custom (POV): the wall label's hand-off to POV (Includes_PovSources.xml, PovMorph). pp.play is set by Play
	     and cleared once POV's own window is up, playback starts, or POV gave up silently; pp.hold covers the gap
	     between POV's loading screen and its source picker. -->
	<timer>
		<name>pp_play</name>
		<description>Wall label Play: waiting for POV</description>
		<start reset="true">String.IsEqual(Window(Home).Property(pp.play),1)</start>
		<stop>Window.IsVisible(progress_media.xml) | Window.IsVisible(sources_results.xml) | Player.HasMedia | Integer.IsGreater(Skin.TimerElapsedSecs(pp_play),20)</stop>
		<onstop>ClearProperty(pp.play,home)</onstop>
	</timer>
	<timer>
		<name>pp_hold</name>
		<description>POV loading screen closed: waiting for the source picker</description>
		<start reset="true">String.IsEqual(Window(Home).Property(pp.hold),1)</start>
		<stop>Window.IsVisible(sources_results.xml) | Player.HasMedia | Integer.IsGreater(Skin.TimerElapsedSecs(pp_hold),2)</stop>
		<onstop>ClearProperty(pp.hold,home)</onstop>
	</timer>
	<!-- custom (POV): the highlighted copy's release name in the source picker, kept in pp.nowfile (+ the film in
	     pp.nowfor) for the Stats panel - debrid links play as an opaque id. Kodi runs no skin click actions in
	     POV's window, so each timer re-copies whenever the highlight moves; on OK the last copy is the pick. -->
	<timer>
		<name>pp_srcname_2000</name>
		<description>Source picker list 2000: remember the highlighted release name</description>
		<start reset="true">Window.IsActive(sources_results.xml) + Control.IsVisible(2000) + !String.IsEmpty(Container(2000).ListItem.Property(tikiskins.name)) + !String.IsEqual(Container(2000).ListItem.Property(tikiskins.name),Window(Home).Property(pp.nowfile))</start>
		<onstart>SetProperty(pp.nowfile,$ESCINFO[Container(2000).ListItem.Property(tikiskins.name)],home)</onstart>
		<onstart>SetProperty(pp.nowfor,$ESCINFO[Window.Property(tikiskins.title)],home)</onstart>
		<stop>true</stop>
	</timer>
	<timer>
		<name>pp_srcname_2001</name>
		<description>Source picker list 2001: remember the highlighted release name</description>
		<start reset="true">Window.IsActive(sources_results.xml) + Control.IsVisible(2001) + !String.IsEmpty(Container(2001).ListItem.Property(tikiskins.name)) + !String.IsEqual(Container(2001).ListItem.Property(tikiskins.name),Window(Home).Property(pp.nowfile))</start>
		<onstart>SetProperty(pp.nowfile,$ESCINFO[Container(2001).ListItem.Property(tikiskins.name)],home)</onstart>
		<onstart>SetProperty(pp.nowfor,$ESCINFO[Window.Property(tikiskins.title)],home)</onstart>
		<stop>true</stop>
	</timer>
	<timer>
		<name>pp_srcname_2002</name>
		<description>Source picker list 2002: remember the highlighted release name</description>
		<start reset="true">Window.IsActive(sources_results.xml) + Control.IsVisible(2002) + !String.IsEmpty(Container(2002).ListItem.Property(tikiskins.name)) + !String.IsEqual(Container(2002).ListItem.Property(tikiskins.name),Window(Home).Property(pp.nowfile))</start>
		<onstart>SetProperty(pp.nowfile,$ESCINFO[Container(2002).ListItem.Property(tikiskins.name)],home)</onstart>
		<onstart>SetProperty(pp.nowfor,$ESCINFO[Window.Property(tikiskins.title)],home)</onstart>
		<stop>true</stop>
	</timer>
</timers>
