<?xml version="1.0" encoding="UTF-8"?>
<!-- CoreELEC box: /storage/.kodi/userdata/advancedsettings.xml (copy by hand, then restart Kodi).
     The GUI runs at 3840x2160. Kodi's defaults cache posters at max 720 px tall and backgrounds at 1080 px,
     which looks soft on a 4K screen (the largest Home posters are ~1600 px tall at 4K). -->
<advancedsettings version="1.0">
	<imageres>2160</imageres>
	<fanartres>2160</fanartres>
</advancedsettings>
